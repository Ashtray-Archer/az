#!/usr/bin/env ysh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ysh_command=${YSH:-ysh}
az_command=${AZ_COMMAND:-"$root/bin/az"}
am_command=${ANDROID_AM:-/system/bin/am}

if test "$#" -lt 1; then
  printf 'usage: ysh android-search/show-results.ysh WORDS...\n' >&2
  exit 2
fi

query=$*
results=$("$ysh_command" "$az_command" search "$@")

"$am_command" start \
  -n org.isomorphisms.az.search/.SearchActivity \
  --es org.isomorphisms.az.SEARCH_QUERY "$query" \
  --es org.isomorphisms.az.SEARCH_RESULTS_TSV "$results"
